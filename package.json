{
  "name": "okfcli",
  "version": "0.1.0",
  "description": "Scaffolding and management of project wikis in Open Knowledge Format (OKF)",
  "keywords": [
    "okf",
    "open-knowledge-format",
    "wiki",
    "documentation",
    "cli",
    "knowledge-base",
    "ai-agents",
    "copilot",
    "markdown",
    "sdd"
  ],
  "author": "Lucas Deprit",
  "license": "MIT",
  "homepage": "https://github.com/lucasdeprit/okfcli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasdeprit/okfcli.git"
  },
  "bugs": {
    "url": "https://github.com/lucasdeprit/okfcli/issues"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "okfcli": "dist/bin/okfcli.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "SPEC.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node scripts/test.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
